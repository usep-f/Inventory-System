{
  "name": "local-inventory-system",
  "version": "1.0.0",
  "description": "Standalone Local Inventory System with mobile QR code scanner and SQLite DB",
  "main": "dist/server/index.js",
  "bin": "dist/server/index.js",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "package": "npm run build && pkg . --targets node18-win-x64 --out-path dist/bin",
    "lint": "eslint . --ext .ts,.tsx",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "pkg": {
    "assets": [
      "dist/client/**/*"
    ],
    "outputPath": "dist/bin"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^11.8.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.39.0",
    "express": "^4.21.2",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "pkg": "^5.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11"
  }
}
